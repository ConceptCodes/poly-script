{
  "$schema": "https://railway.app/railway.schema.json",
  "version": 1,
  "build": {
    "builder": "NIXPACKS_IMAGE_BUILDER"
  },
  "services": {
    "api": {
      "command": "uvicorn apps.api.main:app --host 0.0.0.0 --port $PORT",
      "env": {
        "PORT": "8000",
        "RAILWAY_SERVICE_NAME": "api",
        "DATABASE_URL": "$DATABASE_URL",
        "REDIS_URL": "$REDIS_URL",
        "PYTHONPATH": "/app"
      }
    },
    "worker": {
      "command": "cd apps/worker && python3 -m standalone",
      "env": {
        "RAILWAY_SERVICE_NAME": "worker",
        "DATABASE_URL": "$DATABASE_URL",
        "REDIS_URL": "$REDIS_URL",
        "PYTHONPATH": "/app"
      },
      "replicas": 1
    }
  }
}
