# API Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/polyscript
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=supersecret-replace-in-production
JWT_EXPIRY=24h
ADMIN_JWT_SECRET=admin-supersecret-replace-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
STORAGE_BACKEND=local
STORAGE_PATH=./storage
STORAGE_MIN_FREE_BYTES=0
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email configuration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@polyscript.io

# Application Settings
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,de,es,fr,jp
MAX_UPLOAD_SIZE_MB=100
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_BACKOFF=2

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_STANDARD=price_...
STRIPE_PRICE_ID_PRO=price_...
CREDIT_PRICE_PER_UPLOAD=100

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:8000/api/v1/auth/oauth/google/callback

# URLs
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Expiry & Retention
EMAIL_VERIFICATION_EXPIRY=24
PASSWORD_RESET_EXPIRY=1
INVITATION_EXPIRY=7
DELETION_GRACE_PERIOD_DAYS=30
ORPHANED_CONTENT_RETENTION_DAYS=90

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api/v1
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_DEFAULT_LANGUAGE=en
VITE_ADMIN_MODE=false

# Marketing
PUBLIC_API_URL=http://localhost:8000/api/v1
