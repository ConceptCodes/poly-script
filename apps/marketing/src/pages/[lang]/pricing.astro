---
import "../../styles/global.css";
import SiteLayout from "../../components/SiteLayout.astro";
import { getStaticPaths, getCopy } from "../../lib/i18n";

export { getStaticPaths };

const { lang } = Astro.params;
const t = getCopy(lang);
---

<SiteLayout lang={lang} title="PolyScript — Pricing">
  <section class="container">
    <h1 class="hero-title">{t.pricing.title}</h1>
    <p class="hero-subtitle">{t.pricing.subtitle}</p>
    <div class="pricing" style="margin-top:32px;">
      {t.pricing.plans.map((plan) => (
        <div class="card">
          <div class="tag">{plan.name}</div>
          <h3>{plan.summary}</h3>
          <strong>{plan.price}</strong>
          <ul>
            {plan.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
          <a class="btn primary" href="https://app.polyscript.io/signup">Start now</a>
        </div>
      ))}
    </div>
  </section>
</SiteLayout>
