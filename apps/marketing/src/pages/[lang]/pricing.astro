---
import "../../styles/global.css";
import SiteLayout from "../../components/SiteLayout.astro";
import { getStaticPaths, getCopy } from "../../lib/i18n";

export { getStaticPaths };

const { lang } = Astro.params;
const t = getCopy(lang);
---

<SiteLayout lang={lang} title="PolyScript — Pricing">
  <section class="container">
    <h1 class="hero-title section-title">{t.pricing.title}</h1>
    <p class="hero-subtitle">{t.pricing.subtitle}</p>
    <div class="pricing" style="margin-top:32px;">
      {t.pricing.plans.map((plan, index) => (
        <div class={`card ${index === 1 ? "recommended" : ""}`}>
          {index === 1 && <div class="recommended-badge">Most Popular</div>}
          <div class="tag">{plan.name}</div>
          <h3>{plan.summary}</h3>
          <strong>{plan.price}</strong>
          <ul>
            {plan.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
          <a
            class={`btn ${index === 1 ? "primary" : "ghost"}`}
            href="https://app.polyscript.io/signup"
          >
            Choose plan
          </a>
        </div>
      ))}
    </div>
  </section>

  <!-- JSON-LD PriceSpecification -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "PriceSpecification",
    "name": "PolyScript Pricing",
    "description": "Subscription plans for PolyScript transcription service",
    "priceComponent": t.pricing.plans.map(plan => ({
      "@type": "UnitPriceSpecification",
      "name": plan.name,
      "price": plan.price.replace(/[^\d]/g, ''),
      "priceCurrency": plan.price.includes('€') ? 'EUR' : 'USD',
      "billingIncrement": "P1M",
      "referenceQuantity": {
        "@type": "QuantitativeValue",
        "value": "1",
        "unitCode": "MON"
      }
    }))
  })} />
</SiteLayout>
