---
import "../../styles/global.css";
import SiteLayout from "../../components/SiteLayout.astro";
import { getStaticPaths, getCopy } from "../../lib/i18n";

export { getStaticPaths };

const { lang } = Astro.params;
const t = getCopy(lang);
const apiUrl = import.meta.env.PUBLIC_API_URL || "http://localhost:8000/v1";
---

<SiteLayout lang={lang} title="PolyScript — Contact">
  <section class="container">
    <h1 class="hero-title section-title">{t.contact.title}</h1>
    <p class="hero-subtitle">{t.contact.subtitle}</p>
    <div class="card" style="max-width: 720px; margin-top: 28px;">
      <form
        id="contact-form"
        method="post"
        action={`${apiUrl}/contact`}
        style="display:grid; gap:20px;"
      >
        <label>
          {t.contact.name}
          <input class="input-field" type="text" name="name" required />
        </label>
        <label>
          {t.contact.company}
          <input class="input-field" type="text" name="company" />
        </label>
        <label>
          {t.contact.email}
          <input class="input-field" type="email" name="email" required />
        </label>
        <label>
          {t.contact.message}
          <textarea class="input-field" style="min-height:160px;" name="message" required></textarea>
        </label>
        <button class="btn primary" type="submit">{t.contact.submit}</button>
      </form>
      <p class="muted" style="margin-top:16px;">
        We reply within one business day.
      </p>
    </div>
  </section>
</SiteLayout>
