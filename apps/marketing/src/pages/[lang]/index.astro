---
import "../../styles/global.css";
import SiteLayout from "../../components/SiteLayout.astro";
import { getStaticPaths, getCopy } from "../../lib/i18n";

export { getStaticPaths };

const { lang } = Astro.params;
const t = getCopy(lang);
---

<SiteLayout lang={lang} title="PolyScript — Transcription">
  <section class="container hero">
    <div class="hero-content">
    <div>
      <div class="eyebrow">{t.hero.eyebrow}</div>
      <h1 class="hero-title">{t.hero.title}</h1>
      <p class="hero-subtitle">{t.hero.subtitle}</p>
      <div style="display:flex; gap:12px; margin-top:20px; flex-wrap:wrap;">
        <a class="btn primary" href="https://app.polyscript.io/upload">{t.hero.primary}</a>
        <a class="btn ghost" href="https://app.polyscript.io">{t.hero.secondary}</a>
      </div>
      <p class="muted" style="margin-top:16px;">{t.trust}</p>
    </div>
    </div>
    <div class="hero-card">
      <div class="tag">Queue depth: 12</div>
      <h3 style="margin-top:16px;">Live pipeline snapshot</h3>
      <p class="muted">
        Uploads stream into Redis, workers pull jobs, and results are written back to the team
        workspace.
      </p>
      <div class="grid" style="margin-top:16px;">
        <div class="card">
          <strong>97%</strong>
          <div class="muted">Jobs succeeded in last 24h</div>
        </div>
        <div class="card">
          <strong>4.2m</strong>
          <div class="muted">Median processing time</div>
        </div>
      </div>
    </div>
  </section>

  <section class="container" style="margin-top:80px;">
    <h2 class="section-title">{t.features.title}</h2>
    <div class="grid cols-3" style="margin-top:24px;">
      {t.features.items.map((item, index) => (
        <div class="card">
          <div class="feature-icon" style={`background: ${index === 0 ? 'var(--gradient-blue)' : index === 1 ? 'var(--gradient-orange)' : 'var(--gradient-brand)'};`}>
            {index === 0 && '📊'}
            {index === 1 && '⚡'}
            {index === 2 && '👥'}
          </div>
          <h3 style="margin-top: 20px;">{item.title}</h3>
          <p class="muted">{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container" style="margin-top:80px;">
    <h2 class="section-title">{t.workflow.title}</h2>
    <div class="grid cols-3" style="margin-top:24px;">
      {t.workflow.steps.map((step, index) => (
        <div class="card">
          <div class="tag">Step {index + 1}</div>
          <h3 style="margin-top:12px;">{step.title}</h3>
          <p class="muted">{step.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container" style="margin-top:80px;">
    <h2 class="section-title">{t.pricing.title}</h2>
    <p class="muted">{t.pricing.subtitle}</p>
    <div class="pricing" style="margin-top:24px;">
      {t.pricing.plans.map((plan, index) => (
        <div class={`card ${index === 1 ? 'recommended' : ''}`}>
          {index === 1 && <div class="recommended-badge">Most Popular</div>}
          <div class="tag">{plan.name}</div>
          <h3>{plan.summary}</h3>
          <strong>{plan.price}</strong>
          <ul>
            {plan.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
          <a class={`btn ${index === 1 ? 'primary' : 'ghost'}`} href="https://app.polyscript.io/signup">Choose plan</a>
        </div>
      ))}
    </div>
  </section>

  <!-- JSON-LD SoftwareApplication -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "PolyScript",
    "description": "Multi-language transcription service for teams",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "Web",
    "offers": [
      {
        "@type": "Offer",
        "name": "Free",
        "price": "0",
        "priceCurrency": "USD"
      },
      {
        "@type": "Offer",
        "name": "Standard",
        "price": "10",
        "priceCurrency": "USD",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "10",
          "priceCurrency": "USD",
          "billingIncrement": "P1M"
        }
      },
      {
        "@type": "Offer",
        "name": "Pro",
        "price": "30",
        "priceCurrency": "USD",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "30",
          "priceCurrency": "USD",
          "billingIncrement": "P1M"
        }
      }
    ],
    "featureList": [
      "Live job telemetry",
      "Normalized outputs",
      "Team-ready workflows",
      "Multi-tenant isolation",
      "Real-time progress via SSE"
    ]
  })} />
</SiteLayout>
