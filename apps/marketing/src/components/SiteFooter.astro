---
import { getCopy } from "../lib/i18n";
const { lang } = Astro.props;
const t = getCopy(lang);
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <div class="brand">
        <span class="brand-mark">PS</span>
        <span>PolyScript</span>
      </div>
      <div style="margin-top: 24px;">
        <h4 style="font-family: var(--font-display); font-weight: 600; margin-bottom: 12px; font-size: 14px;">Legal</h4>
        <div class="footer-links">
          <a class="link" href={`/${lang}/legal/terms`}>Terms</a>
          <a class="link" href={`/${lang}/legal/privacy`}>Privacy</a>
        </div>
      </div>
      <p class="muted" style="margin-top: 24px;">{t.footer.tagline}</p>
    </div>
    <div class="footer-links">
      <a class="link" href={`/${lang}/features`}>Features</a>
      <a class="link" href={`/${lang}/pricing`}>Pricing</a>
      <a class="link" href={`/${lang}/docs`}>Docs</a>
      <a class="link" href={`/${lang}/blog`}>Blog</a>
      <a class="link" href={`/${lang}/contact`}>Contact</a>
    </div>
    <div class="footer-cta">
      <div class="tag">Status: All systems nominal</div>
      <a class="btn primary" href="https://app.polyscript.io/signup">Start free</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© 2026 PolyScript.</span>
    <span class="muted">{t.footer.rights}</span>
  </div>
</footer>
