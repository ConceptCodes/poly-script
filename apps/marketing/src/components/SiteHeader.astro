---
import { locales, getCopy } from "../lib/i18n";
const { lang } = Astro.props;
const t = getCopy(lang);
---

<header class="site-header">
  <div class="container nav">
    <a class="brand link" href={`/${lang}`}>
      <span class="brand-mark">PS</span>
      <span>PolyScript</span>
    </a>
    <nav class="nav-links">
      <a class="link" href={`/${lang}/features`}>{t.nav.features}</a>
      <a class="link" href={`/${lang}/pricing`}>{t.nav.pricing}</a>
      <a class="link" href={`/${lang}/docs`}>{t.nav.docs}</a>
      <a class="link" href={`/${lang}/blog`}>{t.nav.blog}</a>
      <a class="link" href={`/${lang}/legal`}>{t.nav.legal}</a>
      <a class="link" href={`/${lang}/contact`}>{t.nav.contact}</a>
    </nav>
    <div class="nav-actions">
      <a class="btn ghost" href="https://app.polyscript.io">
        Sign in
      </a>
      <a class="btn primary" href="https://app.polyscript.io/signup">
        {t.nav.cta}
      </a>
      <div class="lang">
        {locales.map((locale) => (
          <a
            class="link"
            href={`/${locale}`}
            aria-current={locale === lang ? "page" : undefined}
          >
            {locale.toUpperCase()}
          </a>
        ))}
      </div>
    </div>
  </div>
</header>
