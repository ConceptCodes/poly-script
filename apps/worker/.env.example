# Database
DATABASE_URL=postgresql://user:password@localhost:5432/polyscript

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_BACKEND=local
STORAGE_PATH=./storage

# AWS S3 (optional)
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# STT
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=auto

# Queue
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_BACKOFF=2
QUEUE_TIMEOUT=30

# Worker
WORKER_CONSUMER_THREADS=1
WORKER_SHUTDOWN_TIMEOUT=30
